      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "shutter"
    },
    {
      "speaker": "joseph",
      "spokenPhrase": "Violation and fines. One of the key features we develop is our violation selection system.",
      "sourceStartSeconds": 0.59,
      "sourceEndSeconds": 6.69,
      "startSeconds": 98.423333,
      "endSeconds": 104.523333,
      "startFrame": 2953,
      "endFrame": 3136,
