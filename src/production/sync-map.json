      "scene": 5,
      "visualAsset": "screenshots/approved/violator.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "click"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "To support proper documentation, we integrated a camera feature that allows officers to capture photo evidence directly within the application.",
      "sourceStartSeconds": 19.09,
      "sourceEndSeconds": 28.43,
      "startSeconds": 73.39,
      "endSeconds": 82.73,
      "startFrame": 2202,
      "endFrame": 2482,
