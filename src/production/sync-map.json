      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "notification"
    },
    {
      "speaker": "joseph",
      "spokenPhrase": "After completing the required information, our application generates a digital traffic violation ticket.",
      "sourceStartSeconds": 24.57,
      "sourceEndSeconds": 30.01,
      "startSeconds": 122.403333,
      "endSeconds": 127.843333,
