      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "notification"
    },
    {
      "speaker": "joseph",
      "spokenPhrase": "Each ticket includes a unique reference number and QR code to support organized or record management.",
      "sourceStartSeconds": 30.75,
      "sourceEndSeconds": 36.99,
      "startSeconds": 128.583333,
      "endSeconds": 134.823333,
