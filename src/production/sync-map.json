      "visualAsset": "screenshots/approved/violations.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "click"
    },
    {
      "speaker": "joseph",
      "spokenPhrase": "Officers can select the applicable traffic violations and our applications automatically calculates the corresponding total fines.",
      "sourceStartSeconds": 7.55,
      "sourceEndSeconds": 15.25,
      "startSeconds": 105.383333,
      "endSeconds": 113.083333,
      "startFrame": 3162,
      "endFrame": 3392,
