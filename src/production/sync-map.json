      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "click"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "Creating a traffic ticket is more convenient with our application.",
      "sourceStartSeconds": 0.11,
      "sourceEndSeconds": 4.49,
      "startSeconds": 54.41,
      "endSeconds": 58.79,
      "startFrame": 1632,
      "endFrame": 1764,
      "scene": 5,
      "visualAsset": "screenshots/approved/violator.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "click"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "Officers can enter the violator's information, select an address and record vehicle details through guided steps.",
      "sourceStartSeconds": 5.67,
      "sourceEndSeconds": 12.71,
      "startSeconds": 59.97,
      "endSeconds": 67.01,
      "startFrame": 1799,
      "endFrame": 2010,
      "scene": 5,
      "visualAsset": "screenshots/approved/violator.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "click"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "We also included input validations to help minimize encoding errors.",
      "sourceStartSeconds": 13.65,
      "sourceEndSeconds": 18.41,
      "startSeconds": 67.95,
      "endSeconds": 72.71,
      "startFrame": 2038,
