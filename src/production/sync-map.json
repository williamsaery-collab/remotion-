  "phrases": [
    {
      "speaker": "ria",
      "spokenPhrase": "Traffic violations happen in seconds, but documenting them, that can take much longer.",
      "sourceStartSeconds": 0.14,
      "sourceEndSeconds": 6.3,
      "startSeconds": 0.14,
      "endSeconds": 6.3,
      "startFrame": 4,
