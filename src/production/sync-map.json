      "soundEffect": "shutter"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "Smarter enforcement, safer roads.",
      "sourceStartSeconds": 40.19,
      "sourceEndSeconds": 42.45,
      "startSeconds": 94.49,
