      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "Paperwork, manual calculations, delayed records.",
      "sourceStartSeconds": 6.9,
      "sourceEndSeconds": 10.84,
      "startSeconds": 6.9,
      "endSeconds": 10.84,
      "startFrame": 207,
      "endFrame": 325,
      "scene": 2,
      "visualAsset": "vector/process",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "In a world that is becoming more digital, we ask ourselves one question.",
      "sourceStartSeconds": 11.36,
      "sourceEndSeconds": 16.6,
      "startSeconds": 11.36,
      "endSeconds": 16.6,
      "startFrame": 341,
      "endFrame": 498,
      "scene": 2,
      "visualAsset": "vector/process",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "Why not make traffic ticketing smarter?",
      "sourceStartSeconds": 17.38,
      "sourceEndSeconds": 19.36,
      "startSeconds": 17.38,
      "endSeconds": 19.36,
      "startFrame": 521,
      "endFrame": 581,
      "scene": 2,
      "visualAsset": "vector/process",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "That question inspired us.",
      "sourceStartSeconds": 20.88,
      "sourceEndSeconds": 23.24,
      "startSeconds": 20.88,
      "endSeconds": 23.24,
      "startFrame": 626,
      "endFrame": 697,
      "scene": 2,
      "visualAsset": "vector/process",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "We are MiJoRi Tech, and we're introducing our very own innovation.",
      "sourceStartSeconds": 23.64,
      "sourceEndSeconds": 28.2,
      "startSeconds": 23.64,
      "endSeconds": 28.2,
      "startFrame": 709,
      "endFrame": 846,
      "scene": 3,
      "visualAsset": "screenshots/approved/login.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "whoosh"
    },
    {
      "speaker": "ria",
      "spokenPhrase": "LTO Officer, a mobile-based traffic violation ticketing system designed to bring convenience,",
      "sourceStartSeconds": 28.84,
      "sourceEndSeconds": 35.58,
      "startSeconds": 28.84,
      "endSeconds": 35.58,
      "startFrame": 865,
      "endFrame": 1067,
