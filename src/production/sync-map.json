      "visualAsset": "screenshots/approved/camera.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "shutter"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "We also included location functionality, allowing GPS information to be attached when available.",
      "sourceStartSeconds": 29.05,
      "sourceEndSeconds": 35.69,
      "startSeconds": 83.35,
      "endSeconds": 89.99,
      "startFrame": 2500,
      "endFrame": 2700,
      "scene": 6,
      "visualAsset": "screenshots/approved/camera.png",
      "animation": "frame-driven spring entrance, continuous drift and readable focus",
      "transition": "18-frame overlapping lateral reveal",
      "soundEffect": "shutter"
    },
    {
      "speaker": "micah",
      "spokenPhrase": "Bringing innovation to traffic enforcement.",
      "sourceStartSeconds": 36.97,
