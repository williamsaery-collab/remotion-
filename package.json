{
  "name": "mijori-lto-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000 --no-open",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && remotion bundle src/index.ts",
    "render:opening": "remotion render src/index.ts Opening15 out/opening.mp4",
    "render": "remotion render src/index.ts LTOOfficer out/lto-officer.mp4",
    "test": "node --test tests/*.test.mjs",
    "verify:frames": "node scripts/verify-render.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "render:preview": "remotion render src/index.ts Preview20 out/mijori-preview-20s.mp4"
  },
  "dependencies": {
    "@remotion/captions": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/renderer": "4.0.539",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
